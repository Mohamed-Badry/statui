# ==============================================================================
# statui :: Environment Configuration Template
# Copy this file to .env and fill in your actual secrets and endpoint configurations.
# ==============================================================================

# Target host for the HTTPBin demo endpoints in statui.toml
HTTPBIN_HOST=httpbin.org

# Demo bearer authorization token for API health checks
API_BEARER_TOKEN=your-secret-bearer-token-here

# Demo basic authentication credentials (RFC 7617)
BASIC_USER=admin
BASIC_PASS=secret123

# Staging secret key for the PATCH sub-table example
STAGING_TOKEN=your-staging-secret-key-here

# Environment label (e.g. development, staging, production)
STATUI_ENV=development

# Optional client name and webhook secret used in JSON body examples
PROBE_CLIENT=statui-agent
WEBHOOK_SECRET=your-webhook-secret-here
